<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        One place for type and component shape. Layouts reference these
        instead of repeating textSize / textColor pairs, so the four
        screens stay in step with each other. Every text style names
        @font/supreme and a weight, so nothing silently falls back to
        the system face.
    -->

    <!-- ==== Type scale ==== -->

    <style name="TextAppearance.Spotted.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/supreme</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.Spotted.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">@font/supreme</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.Spotted.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/supreme</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.Spotted.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/supreme</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.Spotted.Meta" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/supreme</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- Small all-caps label that opens a section. -->
    <style name="TextAppearance.Spotted.Section" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">@font/supreme</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.09</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- ==== Shape ==== -->

    <style name="ShapeAppearance.Spotted.Photo" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <!-- Detail header; the photo sits inside the page margins. -->
    <style name="ShapeAppearance.Spotted.PhotoHero" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <style name="ShapeAppearance.Spotted.Fab" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item>
    </style>

    <!-- ==== Components ==== -->

    <!--
        The app bar sits on the page colour rather than on primary. A
        full-bleed accent bar is the 2014 look; Material 3 keeps the bar
        quiet and spends the accent on the things you can press.
    -->
    <style name="Widget.Spotted.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">?android:attr/colorBackground</item>
        <item name="titleTextAppearance">@style/TextAppearance.Spotted.ToolbarTitle</item>
        <item name="titleTextColor">?attr/colorOnSurface</item>
        <item name="subtitleTextColor">?attr/colorOnSurfaceVariant</item>
        <item name="navigationIconTint">?attr/colorOnSurface</item>
    </style>

    <style name="Widget.Spotted.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.Spotted.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:fontFamily">@font/supreme</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Widget.Spotted.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="strokeColor">?attr/colorOutline</item>
        <item name="android:fontFamily">@font/supreme</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Widget.Spotted.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:fontFamily">@font/supreme</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Widget.Spotted.Fab" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Spotted.Fab</item>
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="tint">?attr/colorOnPrimary</item>
        <item name="elevation">6dp</item>
    </style>

    <!-- Stars are tinted explicitly; the platform RatingBar ignores colorPrimary. -->
    <style name="Widget.Spotted.RatingBar" parent="Widget.AppCompat.RatingBar">
        <item name="android:progressTint">@color/spot_star</item>
        <item name="android:progressBackgroundTint">?attr/colorOutlineVariant</item>
        <item name="android:secondaryProgressTint">@android:color/transparent</item>
    </style>

    <style name="Widget.Spotted.RatingBar.Small" parent="Widget.AppCompat.RatingBar.Small">
        <item name="android:progressTint">@color/spot_star</item>
        <item name="android:progressBackgroundTint">?attr/colorOutlineVariant</item>
        <item name="android:secondaryProgressTint">@android:color/transparent</item>
    </style>

    <style name="Widget.Spotted.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">?attr/colorPrimary</item>
        <item name="hintTextColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Widget.Spotted.Divider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">?attr/colorOutlineVariant</item>
    </style>

</resources>
