        Rating stars are amber, not primary — red stars sitting on a red
        accent read as one blob. Overridden in values-night/colors.xml.
    -->
    <color name="spot_star">#D08A2E</color>

    <!-- Basic Utilities -->
    <color name="white">#FFFFFFFF</color>
    <color name="black">#FF000000</color>

